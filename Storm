local function ShakeAndThunderOnSpawn()
    task.spawn(function()
        local thunderSound = Instance.new("Sound")
        thunderSound.Volume = 1
        thunderSound.SoundId = "rbxassetid://136669683183289"
        thunderSound.Parent = game.SoundService
        thunderSound:Play()

        task.wait(1.2)
        local thunderSound2 = Instance.new("Sound")
        thunderSound2.Volume = 1
        thunderSound2.PlaybackSpeed = 0.5
        thunderSound2.SoundId = "rbxassetid://15110260312"
        thunderSound2.Parent = game.SoundService
        thunderSound2:Play()
    end)

    local CameraShaker = require(game.ReplicatedStorage.CameraShaker)
    local camara = game.Workspace.CurrentCamera
    local camShake = CameraShaker.new(Enum.RenderPriority.Camera.Value, function(shakeCf)
    camara.CFrame = camara.CFrame * shakeCf
    end)
    camShake:Start()
    camShake:ShakeOnce(20, 10, 0.1, 2, 3.5, 0.5)

    local CC = game.Lighting.MainColorCorrection

    CC.TintColor = Color3.fromRGB(50, 100, 255)
    CC.Brightness = 5
    CC.Contrast = 10
    task.wait(0.1)
    CC.TintColor = Color3.fromRGB(255, 255, 255)
    CC.Contrast = 5
    task.wait(0.1)
    CC.Contrast = 10
    CC.TintColor = Color3.fromRGB(0, 20, 255)
    task.wait(0.1)
    CC.TintColor = Color3.fromRGB(50, 100, 255)
    CC.Brightness = 2
    CC.Contrast = 4

    local tween = game.TweenService:Create(CC,TweenInfo.new(5),{TintColor = Color3.fromRGB(255, 255, 255),Brightness = 0.04, Contrast = 0}):Play()

    task.wait(0.5)
    tween:Play()
end

