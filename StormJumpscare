local jumpscare = game:GetObjects("rbxassetid://137153023291189")[1]
local player = game.Players.LocalPlayer

jumpscare.Parent = player.PlayerGui.MainUI

local TweenService = game:GetService("TweenService")

task.spawn(function()
	while true do
		jumpscare.BackgroundColor3 = Color3.fromRGB(0, 1, 39)
		wait(0.02)
		jumpscare.BackgroundColor3 = Color3.fromRGB(230, 230, 255)
		wait(0.02)
	end
end)

task.spawn(function()
	while task.wait() do
		jumpscare.StormImage.Rotation = math.random(-25, 25)
	end
end)

jumpscare.Visible = true
jumpscare.StormImage.Size = UDim2.new(0.238, 0, 0.709, 0)
jumpscare.StormImage.Position = UDim2.new(0.38, 0, 0.144, 0)
local tween = TweenService:Create(jumpscare.StormImage, TweenInfo.new(1), {Position = UDim2.new(-0.451, 0, -2, 0)})
local tween2 = TweenService:Create(jumpscare.StormImage, TweenInfo.new(1), {Size = UDim2.new(1.9, 0, 5, 0)})
task.wait()
jumpscare.Sound:Play()
task.wait(0.05)
tween2:Play()
tween:Play()
task.wait(1.5)
jumpscare.Visible = false
jumpscare.StormImage.Size = UDim2.new(0.238, 0, 0.709, 0)
jumpscare.StormImage.Position = UDim2.new(0.38, 0, 0.144, 0)

wait(3)
jumpscare:Destroy()
